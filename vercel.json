{
  "version": 2,
  "routes": [
    {
      "src": "/BITS/(.+)",
      "dest": "/api/index.js"
    },
    {
      "src": "/CV/(.+)",
      "dest": "/api/index.js"
    },
    {
      "src": "/HSCertificate/(.+)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/(.+)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{script.js,index.html,lib/cv-fonts/**,node_modules/@sparticuz/chromium/**}",
      "maxDuration": 60
    }
  }
}
